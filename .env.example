# Isolated local-development defaults. review-tunnel.v1 without authentication or TLS; loopback only.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
CONTENT_DOMAIN=localhost

# Deliberately unsafe escape hatch for an isolated test network only.
# ALLOW_INSECURE_POC=true

# Authenticated Gateway mode using two DNS names under one base domain (use a secret manager in production):
# GATEWAY_HOST=0.0.0.0
# CONTENT_DOMAIN=preview.tunnel.example.com
# PUBLIC_CONTENT_ORIGIN=https://preview.tunnel.example.com
# CONTROL_HOST=control.tunnel.example.com
# DATABASE_URL=postgres://review_tunnel:password@postgres:5432/review_tunnel
# AUTH_SESSION_HMAC_KEY=<canonical base64url random value of 32 to 128 bytes>
# AUTH_SESSION_HMAC_KEY_PREVIOUS=<up to 3 distinct comma-separated prior keys during rotation>
# AUTO_MIGRATE=false
# Enable after every Gateway supports migrations 19–21.
# REVIEW_WORKFLOW_ENABLED=false
# DEPLOYMENT_ID=release-2026-08-24.1
# DEPLOYMENT_CONFIG_DIGEST=sha256:<64 lowercase hex characters>
# CANARY_HOST=canary.preview.tunnel.example.com
# CANARY_BEARER_TOKEN=<random value of 32 to 512 characters>
# OPERATIONAL_STATE_POLL_INTERVAL_MS=2000
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_QUERY_TIMEOUT_MS=3000
# REVIEW_EVENT_POLL_INTERVAL_MS=500
# REVIEW_EVENT_HEARTBEAT_INTERVAL_MS=15000
# REVIEW_EVENT_RETRY_MS=1000
# MAX_REVIEW_EVENT_CONNECTIONS=128
# MAX_REVIEW_EVENT_CONNECTIONS_PER_ACCOUNT=4
# MAX_REVIEW_EVENTS=100000
# REVIEW_EVENT_RETENTION_MS=604800000
# METRICS_BEARER_TOKEN=<random value of 32 to 512 characters>
# MAX_PENDING_TUNNELS=64
# MAX_ACTIVE_TUNNELS=1024
# MAX_TUNNELS_PER_ACCOUNT=8
# LOGIN_INTENTS_PER_SOURCE_PER_MINUTE=20
# LOGIN_INTENTS_GLOBAL_PER_MINUTE=1000
# MAX_CONCURRENT_LOGIN_ATTEMPTS=32
# MAX_CONCURRENT_LOGIN_ATTEMPTS_PER_REMOTE=4
# LOGIN_ATTEMPTS_PER_MINUTE=1000
# LOGIN_ATTEMPTS_PER_REMOTE_PER_MINUTE=30
# MAX_CONCURRENT_WEB_AUTHORIZATIONS=32
# MAX_CONCURRENT_WEB_AUTHORIZATIONS_PER_REMOTE=4
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8:ffff::/48
# MAX_FORWARDED_FOR_ENTRIES=16
# MAX_OUTSTANDING_CARRIER_CREDENTIALS=128
# MAX_OUTSTANDING_CARRIER_CREDENTIALS_PER_ACCOUNT=8
# CARRIER_CREDENTIALS_PER_MINUTE=1000
# CARRIER_CREDENTIALS_PER_ACCOUNT_PER_MINUTE=60
# MAX_AUTH_SESSIONS=100000
# MAX_AUTH_SESSIONS_PER_ACCOUNT=64
# MAX_SESSION_EXCHANGES=10000
# MAX_SESSION_EXCHANGES_PER_ACCOUNT=256
# MAX_LOGIN_THROTTLES=100000
# MAX_AUDIT_EVENTS=1000000
# AUDIT_OPERATIONAL_RESERVE=1000
# MAX_PENDING_CARRIER_FRAMES=128
# MAX_PENDING_CARRIER_BYTES=262204
# MAX_CANARY_WEBSOCKETS=4
# CANARY_WEBSOCKET_IDLE_TIMEOUT_MS=30000
# MAX_REQUEST_BODY_BYTES=16777216
# MAX_FINITE_RESPONSE_BYTES=67108864
# MAX_CONCURRENT_STREAMS=128
# MAX_NEW_STREAMS_PER_MINUTE=600
# RESPONSE_HEADER_TIMEOUT_MS=10000
# STREAM_INACTIVITY_TIMEOUT_MS=120000
# MAX_STREAM_DURATION_MS=14400000
# HEARTBEAT_INTERVAL_MS=15000
# CARRIER_LEASE_MS=45000
# AUTHORIZATION_MAX_AGE_MS=43200000
# REVOCATION_CHECK_INTERVAL_MS=5000
