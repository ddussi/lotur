# Isolated local-development defaults. review-tunnel.v1 without authentication or TLS; loopback only.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
CONTENT_DOMAIN=localhost

# Deliberately unsafe escape hatch for an isolated test network only.
# ALLOW_INSECURE_POC=true

# Internal-account mode example (use a secret manager in production):
# GATEWAY_HOST=0.0.0.0
# CONTENT_DOMAIN=preview.example.com
# CONTROL_HOST=control.example.net
# DATABASE_URL=postgres://review_tunnel:password@postgres:5432/review_tunnel
# AUTH_SESSION_HMAC_KEY=<base64url-encoded random value of at least 32 bytes>
# AUTH_SESSION_HMAC_KEY_PREVIOUS=<comma-separated prior keys during rotation>
# AUTO_MIGRATE=false
# KILL_SWITCH_ENABLED=false
# GATEWAY_ADMISSION_READY=false
# METRICS_BEARER_TOKEN=<random value of at least 32 characters>
# MAX_REQUEST_BODY_BYTES=16777216
# MAX_FINITE_RESPONSE_BYTES=67108864
# MAX_CONCURRENT_STREAMS=128
# MAX_NEW_STREAMS_PER_MINUTE=600
# RESPONSE_HEADER_TIMEOUT_MS=10000
# STREAM_INACTIVITY_TIMEOUT_MS=120000
# MAX_STREAM_DURATION_MS=14400000
# HEARTBEAT_INTERVAL_MS=15000
# CARRIER_LEASE_MS=45000
# AUTHORIZATION_MAX_AGE_MS=43200000
# REVOCATION_CHECK_INTERVAL_MS=5000
