{
  "name": "review-tunnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:gateway": "node --experimental-strip-types apps/gateway/src/main.ts",
    "dev:client": "node --experimental-strip-types apps/client/src/main.ts",
    "admin": "node --experimental-strip-types apps/admin-cli/src/main.ts",
    "test": "node --experimental-strip-types --test packages/*/src/*.test.ts apps/*/src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run build && npm test",
    "test:postgres": "node --experimental-strip-types --test packages/storage-postgres/src/postgres-auth-repository.integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "pg": "^8.23.0",
    "tldts": "^7.4.10"
  }
}
